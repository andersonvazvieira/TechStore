@model TechStore.Web.Models.CategoryViewModel

@{
    ViewData["Title"] = "Editar categoria";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1 class="display-6 fw-bold">
            Editar categoria
        </h1>

        <p class="text-muted">
            Altere as informações da categoria
        </p>
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            @if (ViewBag.Erro != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Erro
                </div>
            }

            <form method="post">

                <input type="hidden"
                       asp-for="Id" />

                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label">
                        Nome da categoria
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           required />

                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Salvar alterações
                </button>

                <a asp-controller="Categories"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>

    </div>

</div>