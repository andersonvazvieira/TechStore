@model List<TechStore.Web.Models.ProductViewModel>

@{
    ViewData["Title"] = "Produtos";
}

<div class="container mt-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="display-6 fw-bold">Produtos</h1>
            <p class="text-muted mb-0">
                Produtos cadastrados no sistema
            </p>
        </div>

        <a asp-controller="Products"
           asp-action="Create"
           class="btn btn-primary">
            Novo produto
        </a>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success" role="status">
            @TempData["Sucesso"]
        </div>
    }

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["Erro"]
        </div>
    }

    @if (ViewBag.Erro != null)
    {
        <div class="alert alert-danger" role="alert">
            @ViewBag.Erro
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form method="get"
                  asp-controller="Products"
                  asp-action="Index"
                  role="search"
                  aria-label="Pesquisar produtos">

                <div class="row g-3 align-items-end">
                    <div class="col-md-9">
                        <label for="pesquisa-produtos"
                               class="form-label">
                            Pesquisar por nome ou código
                        </label>

                        <input id="pesquisa-produtos"
                               type="search"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Digite o nome ou código"
                               aria-describedby="pesquisa-ajuda" />

                        <p id="pesquisa-ajuda"
                           class="form-text text-muted mb-0">
                            Preencha o campo e selecione Pesquisar.
                            Para exibir todos os produtos, selecione Limpar.
                        </p>
                    </div>

                    <div class="col-md-3 d-flex flex-wrap gap-2">
                        <button type="submit"
                                class="btn btn-primary">
                            Pesquisar
                        </button>

                        <a asp-controller="Products"
                           asp-action="Index"
                           class="btn btn-secondary">
                            Limpar
                            <span class="visually-hidden">
                                pesquisa de produtos
                            </span>
                        </a>
                    </div>
                </div>
            </form>

        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info" role="status">
            Nenhum produto encontrado.
        </div>
    }
    else
    {
        <p id="resumo-produtos" class="text-muted">
            Produtos encontrados: @Model.Count.
        </p>

        <div class="card shadow-sm">
            <div class="card-body">

                <p id="tabela-ajuda" class="text-muted">
                    Em telas pequenas, a tabela pode ser rolada
                    horizontalmente. Pelo teclado, foque a região
                    da tabela e use as setas esquerda e direita.
                </p>

                <div class="table-responsive"
                     role="region"
                     aria-label="Tabela de produtos"
                     aria-describedby="tabela-ajuda"
                     tabindex="0">

                    <table class="table table-hover align-middle"
                           aria-describedby="resumo-produtos">

                        <caption class="visually-hidden">
                            Produtos cadastrados, preços, quantidades
                            em estoque e ações disponíveis.
                        </caption>

                        <thead>
                            <tr>
                                <th scope="col">Código</th>
                                <th scope="col">Produto</th>
                                <th scope="col">Categoria</th>
                                <th scope="col">Preço</th>
                                <th scope="col">Estoque</th>
                                <th scope="col">Situação</th>
                                <th scope="col" class="text-end">
                                    Ações
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var product in Model)
                            {
                                <tr>
                                    <td>@product.Code</td>

                                    <th scope="row" class="fw-normal">
                                        @product.Name
                                    </th>

                                    <td>
                                        @(product.Category?.Name ?? "Sem categoria")
                                    </td>

                                    <td>
                                        @product.Price.ToString("C")
                                    </td>

                                    <td>@product.Quantity</td>

                                    <td>
                                        @if (product.Quantity <= product.MinimumStock)
                                        {
                                            <span class="badge bg-danger">
                                                Estoque baixo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Normal
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <a asp-controller="Products"
                                           asp-action="Edit"
                                           asp-route-id="@product.Id"
                                           class="btn btn-sm btn-warning">
                                            Editar
                                            <span class="visually-hidden">
                                                produto @product.Name,
                                                código @product.Code
                                            </span>
                                        </a>

                                        <a asp-controller="Products"
                                           asp-action="Delete"
                                           asp-route-id="@product.Id"
                                           class="btn btn-sm btn-danger">
                                            Excluir
                                            <span class="visually-hidden">
                                                produto @product.Name,
                                                código @product.Code
                                            </span>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

            </div>
        </div>
    }

</div>