@model TechStore.Web.Models.ProductViewModel

@{
    ViewData["Title"] = "Excluir produto";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1 class="display-6 fw-bold">Excluir produto</h1>

        <p class="text-muted">
            Confirme a exclusão do produto
        </p>
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="alert alert-warning">
                <strong>Atenção!</strong>
                Tem certeza de que deseja excluir este produto?
            </div>

            <dl class="row">

                <dt class="col-sm-3">
                    Produto
                </dt>

                <dd class="col-sm-9">
                    @Model.Name
                </dd>

                <dt class="col-sm-3">
                    Código
                </dt>

                <dd class="col-sm-9">
                    @Model.Code
                </dd>

                <dt class="col-sm-3">
                    Categoria
                </dt>

                <dd class="col-sm-9">
                    @(Model.Category?.Name ?? "Sem categoria")
                </dd>

                <dt class="col-sm-3">
                    Preço
                </dt>

                <dd class="col-sm-9">
                    R$ @Model.Price.ToString("N2")
                </dd>

                <dt class="col-sm-3">
                    Estoque atual
                </dt>

                <dd class="col-sm-9">
                    @Model.Quantity
                </dd>

            </dl>

            <form method="post">

                <input type="hidden"
                       name="Id"
                       value="@Model.Id" />

                <button type="submit"
                        class="btn btn-danger">
                    Confirmar exclusão
                </button>

                <a href="/Products"
                   class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>

    </div>

</div>