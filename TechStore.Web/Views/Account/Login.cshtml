@model TechStore.Web.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card shadow">
                <div class="card-body p-4">

                    <div class="text-center mb-4">
                        <h1 id="login-titulo" class="h2 fw-bold">
                            TechStore
                        </h1>

                        <p id="login-descricao" class="text-muted">
                            Acesse o sistema de estoque.
                            Os campos e-mail e senha são obrigatórios.
                        </p>
                    </div>

                    @if (ViewBag.Erro != null)
                    {
                        <div class="alert alert-danger"
                             role="alert">
                            @ViewBag.Erro
                        </div>
                    }

                    <form asp-controller="Account"
                          asp-action="Login"
                          method="post"
                          aria-labelledby="login-titulo"
                          aria-describedby="login-descricao">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger"
                             role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Email"
                                   class="form-label">
                                E-mail
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="Digite seu e-mail"
                                   autocomplete="username"
                                   autocapitalize="none"
                                   spellcheck="false"
                                   aria-describedby="email-erro"
                                   required />

                            <span asp-validation-for="Email"
                                  id="email-erro"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password"
                                   class="form-label">
                                Senha
                            </label>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Digite sua senha"
                                   autocomplete="current-password"
                                   aria-describedby="senha-erro"
                                   required />

                            <span asp-validation-for="Password"
                                  id="senha-erro"
                                  class="text-danger"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit"
                                    class="btn btn-primary">
                                Entrar
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>