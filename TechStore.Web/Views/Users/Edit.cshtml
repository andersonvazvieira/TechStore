@model TechStore.Web.Models.UserViewModel

@{
    ViewData["Title"] = "Editar usuário";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1 class="display-6 fw-bold">
            Editar usuário
        </h1>

        <p class="text-muted">
            Altere os dados do usuário
        </p>
    </div>

    @if (ViewBag.Erro != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Erro
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-controller="Users"
                  asp-action="Edit"
                  method="post">

                <input type="hidden"
                       asp-for="Id" />

                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label">
                        Nome
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Digite o nome do usuário"
                           required />

                </div>

                <div class="mb-3">

                    <label asp-for="Email"
                           class="form-label">
                        E-mail
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="Digite o e-mail"
                           required />

                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Salvar alterações
                    </button>

                    <a asp-controller="Users"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>