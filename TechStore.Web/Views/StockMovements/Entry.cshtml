@model TechStore.Web.Models.StockMovementViewModel

@{
    ViewData["Title"] = "Entrada de estoque";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1 class="display-6 fw-bold">
            Entrada de estoque
        </h1>

        <p class="text-muted">
            Registre a entrada de produtos no estoque
        </p>
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            @if (ViewBag.Erro != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Erro
                </div>
            }

            <form method="post">

                <div class="row g-3">

                    <div class="col-md-6">

                        <label class="form-label">
                            Produto
                        </label>

                        <select name="ProductId"
                                class="form-select"
                                required>

                            <option value="">
                                Selecione um produto
                            </option>

                            @foreach (var product in ViewBag.Products)
                            {
                                <option value="@product.Id">
                                    @product.Name
                                    - Estoque atual: @product.Quantity
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            Quantidade de entrada
                        </label>

                        <input type="number"
                               name="Quantity"
                               class="form-control"
                               min="1"
                               required />

                    </div>

                    <div class="col-12">

                        <label class="form-label">
                            Observação
                        </label>

                        <textarea name="Observation"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Ex.: Compra de mercadoria"></textarea>

                    </div>

                    <input type="hidden"
                           name="Type"
                           value="Entrada" />

                    <div class="col-12 mt-4">

                        <button type="submit"
                                class="btn btn-success">
                            Registrar entrada
                        </button>

                        <a href="/StockMovements"
                           class="btn btn-secondary">
                            Cancelar
                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>