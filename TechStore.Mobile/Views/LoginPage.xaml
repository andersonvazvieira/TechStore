<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TechStore.Mobile.Views.LoginPage"
    Title="Login"
    BackgroundColor="#F5F7FA">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">

            <VerticalStackLayout
                Spacing="5"
                HorizontalOptions="Center">

                <Label
                    Text="TechStore"
                    FontSize="36"
                    FontAttributes="Bold"
                    TextColor="#0D6EFD"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Controle de estoque"
                    FontSize="16"
                    TextColor="#6C757D"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <Border
                Padding="25"
                BackgroundColor="White"
                Stroke="#DEE2E6"
                StrokeThickness="1">

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="Entrar"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="#212529" />

                    <Label
                        Text="E-mail"
                        FontAttributes="Bold" />

                    <Entry
                        x:Name="EmailEntry"
                        Placeholder="Digite seu e-mail"
                        Keyboard="Email"
                        ReturnType="Next" />

                    <Label
                        Text="Senha"
                        FontAttributes="Bold" />

                    <Entry
                        x:Name="PasswordEntry"
                        Placeholder="Digite sua senha"
                        IsPassword="True"
                        ReturnType="Done" />

                    <Label
                        x:Name="ErrorLabel"
                        TextColor="#DC3545"
                        IsVisible="False"
                        HorizontalTextAlignment="Center" />

                    <ActivityIndicator
                        x:Name="LoadingIndicator"
                        IsRunning="False"
                        IsVisible="False"
                        HorizontalOptions="Center" />

                    <Button
                        x:Name="LoginButton"
                        Text="Entrar"
                        HeightRequest="50"
                        FontAttributes="Bold"
                        Clicked="OnLoginClicked" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>